# Required — Cursor user or team service-account key (Dashboard → Integrations)
CURSOR_API_KEY=cursor_...

# Optional — bearer token clients must send (recommended if you bind beyond loopback)
# PROXY_API_KEY=change-me

# Workspace the local Cursor agent runs against (defaults to process.cwd())
# CURSOR_WORKSPACE=d:\coding\my-projects

# Host / port
# HOST=127.0.0.1
# PORT=8766
